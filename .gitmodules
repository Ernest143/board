[submodule "lib/st/stm32f1xx_hal_driver"]
	path = lib/st/stm32f1xx_hal_driver
	url = https://github.com/STMicroelectronics/stm32f1xx_hal_driver.git
[submodule "lib/FreeRTOS/FreeRTOS-Kernel"]
	path = lib/FreeRTOS/FreeRTOS-Kernel
	url = https://github.com/FreeRTOS/FreeRTOS-Kernel.git
